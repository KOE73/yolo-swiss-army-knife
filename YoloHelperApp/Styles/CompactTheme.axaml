<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Global Visual Settings for Compact Theme (Схема) -->
        <Thickness x:Key="CompactPadding">4,2,4,2</Thickness>
        <Thickness x:Key="CompactMargin">0,0,0,3</Thickness>
        <x:Double x:Key="CompactHeight">26</x:Double>
        <x:Double x:Key="CompactFontSize">13</x:Double>
        
        <!-- Layout Margins and Paddings -->
        <Thickness x:Key="MainTabPadding">12</Thickness>
        <Thickness x:Key="DetailTabPadding">8</Thickness>
        <Thickness x:Key="PageMargin">6</Thickness>
        <Thickness x:Key="SplitterMargin">3,0</Thickness>
        <Thickness x:Key="ColumnMargin">8,0,0,0</Thickness>
    </Styles.Resources>

    <!-- Global implicit styles applying the compact values -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="{DynamicResource CompactPadding}"/>
        <Setter Property="Height" Value="{DynamicResource CompactHeight}"/>
        <Setter Property="Margin" Value="{DynamicResource CompactMargin}"/>
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Padding" Value="{DynamicResource CompactPadding}"/>
        <Setter Property="Height" Value="{DynamicResource CompactHeight}"/>
        <Setter Property="Margin" Value="{DynamicResource CompactMargin}"/>
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Padding" Value="{DynamicResource CompactPadding}"/>
        <Setter Property="Height" Value="{DynamicResource CompactHeight}"/>
        <Setter Property="Margin" Value="{DynamicResource CompactMargin}"/>
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding" Value="{DynamicResource CompactPadding}"/>
        <Setter Property="Height" Value="{DynamicResource CompactHeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Margin" Value="{DynamicResource CompactMargin}"/>
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
    </Style>

    <Style Selector="TextBlock:not(.header)">
        <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
    </Style>
</Styles>
