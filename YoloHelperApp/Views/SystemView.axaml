<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoloHelperApp.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="YoloHelperApp.Views.SystemView"
             x:DataType="vm:SystemViewModel">
  <Grid RowDefinitions="*,180" Margin="{DynamicResource PageMargin}" RowSpacing="8">
    <!-- Top Diagnostics Cards -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="System Environment Doctor" Classes="header" Foreground="{DynamicResource AccentBrush}"/>

        <!-- Application settings: UI language + *.ysak shell integration -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Application" FontSize="14" FontWeight="Bold"/>
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="Interface language:" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" Width="80" SelectedItem="{Binding Localization.CurrentLanguage}">
                <sys:String>RU</sys:String>
                <sys:String>EN</sys:String>
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Button Content="Register *.ysak file association"
                      Command="{Binding RegisterFileAssociationCommand}"
                      IsEnabled="{Binding CanRegisterFileAssociation}"/>
              <TextBlock Grid.Column="1" Text="{Binding FileAssociationStatus}" VerticalAlignment="Center"
                         Classes="secondary" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding FileAssociationStatus}"/>
            </Grid>
            <TextBlock Text="After registering, double-clicking a .ysak file opens the project, and recent projects appear in the taskbar jump list (right-click the taskbar icon)."
                       Classes="desc"/>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
          <!-- Python Card -->
          <Border Grid.Row="0" Grid.Column="0" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z" 
                    Fill="{Binding PythonFound, Converter={StaticResource BooleanToBrushConverter}}" Width="32" Height="32" Margin="0,0,15,0"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Python Runtime" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding PythonVersion}" FontSize="12" Classes="secondary"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- CUDA Card -->
          <Border Grid.Row="0" Grid.Column="1" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <!-- Simple green/red indicator -->
              <Ellipse Width="16" Height="16" Fill="{Binding CudaAvailable, Converter={StaticResource BooleanToBrushConverter}}" Margin="0,0,15,0"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="NVIDIA CUDA Acceleration" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding CudaVersion, StringFormat='{}CUDA Version: {0}'}" FontSize="12" Classes="secondary"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Ultralytics Card -->
          <Border Grid.Row="1" Grid.Column="0" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <Ellipse Width="16" Height="16" Fill="{Binding UltralyticsFound, Converter={StaticResource BooleanToBrushConverter}}" Margin="0,0,15,0"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Ultralytics (YOLO)" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding UltralyticsVersion, StringFormat='{}Version: {0}'}" FontSize="12" Classes="secondary"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- PyTorch Card -->
          <Border Grid.Row="1" Grid.Column="1" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <Ellipse Width="16" Height="16" Fill="{Binding PythonFound, Converter={StaticResource BooleanToBrushConverter}}" Margin="0,0,15,0"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="PyTorch Framework" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding PyTorchVersion, StringFormat='{}Version: {0}'}" FontSize="12" Classes="secondary"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Grid.Column="0" Content="Run Diagnostic Check" Command="{Binding DiagnoseCommand}" 
                  Background="#1F8AD2" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4"/>
          <Button Grid.Column="1" Content="Install/Update Dependencies" Command="{Binding InstallCommand}" 
                  Background="Green" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Install Console -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="Dependencies Installation Terminal Output" FontSize="12" FontWeight="Bold" Classes="secondary"/>
      <ScrollViewer Grid.Row="1" Background="Black" CornerRadius="5" Padding="8">
        <TextBlock Text="{Binding InstallLog}" Foreground="Lime" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
