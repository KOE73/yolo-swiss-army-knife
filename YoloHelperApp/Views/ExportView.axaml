<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoloHelperApp.ViewModels"
             x:Class="YoloHelperApp.Views.ExportView"
             x:DataType="vm:ExportViewModel">
  <Grid ColumnDefinitions="320,6,*" Margin="0">
    <!-- Left Column: Profiles List -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="6">
      <TextBlock Grid.Row="0" Text="Export Profiles" FontSize="16" FontWeight="Bold" Foreground="#1F8AD2" Margin="4,0,0,0"/>
      
      <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="5">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}" Margin="0,0,8,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summarize}" FontSize="11" Foreground="Gray"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="2" ColumnDefinitions="*,*">
        <Button Grid.Column="0" Content="Add Profile" Command="{Binding AddProfileCommand}" Background="Green" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0"/>
        <Button Grid.Column="1" Content="Delete Profile" Command="{Binding DeleteProfileCommand}" Background="Red" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0"/>
      </Grid>
    </Grid>

    <!-- Splitter -->
    <GridSplitter Grid.Column="1" Width="6" Background="#E4E7EB" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="{DynamicResource SplitterMargin}"/>

    <!-- Right Column: Profile Editor & Export Actions -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource ColumnMargin}" Padding="0,0,10,0">
      <StackPanel Spacing="5">
        <TextBlock Text="Edit Selected Profile" FontSize="16" FontWeight="Bold" Foreground="#1F8AD2"/>
        
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="5">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Format:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectedItem="{Binding Format}" ItemsSource="{Binding AvailableFormats}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Opset Versions (comma separated):" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OpsetVersionCsv}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch Sizes (comma separated, e.g. 1,4,dynamic):" VerticalAlignment="Center"/>
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BatchSizesCsv}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Image Sizes (comma separated, step 32):" VerticalAlignment="Center"/>
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ExportImgSizesCsv}" LostFocus="ImgSizes_LostFocus"/>
        </Grid>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="5">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Precision(s):" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <CheckBox Content="FP32" IsChecked="{Binding ExportFp32}"/>
            <CheckBox Content="FP16" IsChecked="{Binding ExportFp16}"/>
            <CheckBox Content="INT8" IsChecked="{Binding ExportInt8}"/>
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Simplify Graph (simplify=True):" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Simplify}" OffContent="No" OnContent="Yes"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Include NMS Node (nms=True):" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Nms}" OffContent="No" OnContent="Yes"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Inject ByteBGR preprocessing node:" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="5">
             <ToggleSwitch IsChecked="{Binding InjectByteBgr}" IsEnabled="{Binding IsByteBgrAvailable}" OffContent="No" OnContent="Yes"/>
             <TextBlock Text="Uses your NeuroModFlowNet.ONNX.Tools inject utility" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Separator Height="1" Background="#E4E7EB"/>

        <!-- Export Weights path -->
        <TextBlock Text="Weights Target" FontSize="14" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0" PlaceholderText="Path to best.pt file" Text="{Binding BestPtPath}"/>
          <Button Grid.Column="1" Content="Browse best.pt" Click="OnBrowseBestPtClick" Background="#1F8AD2" Foreground="White"/>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
          <Button Grid.Column="0" Content="Export Current Profile" Command="{Binding StartBatchExportCommand}"
                  Background="#1F8AD2" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40" CornerRadius="5"/>
          <Button Grid.Column="1" Content="Export All Profiles" Command="{Binding ExportAllProfilesCommand}"
                  Background="#9333EA" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40" CornerRadius="5"/>
        </Grid>

        <!-- Console Log -->
        <TextBlock Text="Export Output Logs" FontSize="14" FontWeight="Bold"/>
        <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto" Background="Black" CornerRadius="5" Padding="8">
          <TextBlock Text="{Binding ExportLog}" Foreground="Lime" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
        </ScrollViewer>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
